# ==============================================================================
#  Shivaayaha Silk Sarees — CLIENT Environment Variables TEMPLATE
#  File: client/.env.example
#  ✅  This file IS committed to Git — it is the public reference template.
#      Copy it:  cp client/.env.example client/.env   then fill in real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# API BASE URL
# ------------------------------------------------------------------------------
# LOCAL DEV: Leave as "/api" — Vite proxy handles it (see vite.config.js)
# PRODUCTION: Full URL of your deployed backend, e.g.:
#   VITE_API_URL=https://shivaayaha-api.railway.app/api
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# APP META
# ------------------------------------------------------------------------------
VITE_APP_NAME=Shivaayaha Silk Sarees
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
# Set to "true" to enable verbose API debug logging in the browser console
VITE_DEBUG_API=false
